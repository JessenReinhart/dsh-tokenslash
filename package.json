{
  "name": "dsh-tokenslash",
  "version": "1.0.0",
  "description": "TypeSafe Jev token optimization suite for DeepSeek Harness (DSH): Subagent Router, Fork Decoupler, Tool Schema Pruner, Output Compactor, and Settings UI",
  "keywords": [
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "prompt-pruning",
    "token-optimization",
    "subagent-routing"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test",
    "install:profile": "node scripts/install.mjs",
    "publish:npm": "node scripts/publish.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JessenReinhart/dsh-tokenslash.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "gpt-tokenizer": "4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  }
}
